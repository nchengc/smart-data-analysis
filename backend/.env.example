# ========== 阿里云百炼 DashScope API Key（必填） ==========
# 在 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 服务器配置 ==========
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ========== CORS ==========
# 前端 dev server 默认端口是 5173，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== Phase 2+ 生效（Phase 0 留空即可） ==========
QWEN_CHAT_MODEL=qwen3-plus
QWEN_SQL_MODEL=qwen3-coder-plus
REQUEST_TIMEOUT=60
SQLITE_PATH=./data/app.db
